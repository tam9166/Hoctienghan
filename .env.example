# Optional server-side translation provider (not used by offline MVP)
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SMALL_MODEL=
OPENAI_STRONG_MODEL=
# Enforce server-authoritative AI quotas only after subscription entitlements are deployed.
BILLING_ENFORCEMENT_ENABLED=false
# Optional provider pricing snapshot in micro-units per one million tokens.
# Leave blank when pricing is not configured; the app will report token usage without inventing cost.
OPENAI_INPUT_COST_PER_MILLION_MICROS=
OPENAI_OUTPUT_COST_PER_MILLION_MICROS=
# Public Supabase config read only by the serverless /api/config endpoint
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Public canonical URL used only by smoke checks and uptime monitoring
PRODUCTION_URL=
# Optional extra HTTPS origins; Capacitor defaults are already allowlisted server-side
MOBILE_ALLOWED_ORIGINS=
MOBILE_API_BASE_URL=
