{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TamHoanq mobile wrapper contract",
  "type": "object",
  "required": ["contractVersion", "appId", "appName", "webDir", "platforms", "bridge", "api", "identity", "offline", "releaseChannels", "security"],
  "properties": {
    "contractVersion": { "type": "integer", "minimum": 2 },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
    "appName": { "type": "string", "minLength": 1 },
    "webDir": { "type": "string" },
    "nativeWrapper": { "type": "string" },
    "platforms": { "type": "object", "required": ["android", "ios"] },
    "bridge": { "type": "object" },
    "api": { "type": "object", "required": ["resolver", "releaseEnvironment", "cleartextAllowed"] },
    "identity": { "type": "object", "required": ["provider", "flow", "deepLink", "sharedWithWeb"] },
    "offline": { "type": "object", "required": ["content", "progressQueue", "reconnect"] },
    "releaseChannels": { "type": "array", "items": { "enum": ["internal", "beta", "production"] }, "minItems": 3, "uniqueItems": true },
    "security": { "type": "object" }
  }
}
